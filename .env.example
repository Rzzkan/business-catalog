# Cloudflare R2 (S3-compatible) storage for uploaded images.
# Copy this file to .env.local for local testing with `vercel dev`, and set
# the same keys in the Vercel project dashboard (Settings > Environment
# Variables) for Production/Preview. Never commit the real values.

# Cloudflare account id
R2_ACCOUNT_ID=4e6117e8b8c6536956eb1040a75fc2e0

# From an R2 API token scoped to the bucket below (Cloudflare dashboard > R2 >
# Manage API Tokens > Create API Token > Object Read & Write, limited to this bucket)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The R2 bucket name used for uploaded images
R2_BUCKET_NAME=katalog-bisnis-media

# Public base URL for the bucket (no trailing slash). The quick pub-xxxx.r2.dev
# URL Cloudflare gives you once "Public access" is enabled on the bucket, or a
# custom domain connected to it.
R2_PUBLIC_BASE_URL=
